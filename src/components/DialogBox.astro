---
/**
 * Cadre de dialogue : portrait + texte tapé lettre par lettre.
 * - clic / Entrée / Espace / Z : termine la ligne, puis passe à la suivante
 * - « Passer » ou Échap / X : affiche tout d'un coup
 * - à la fin, émet `dialog:done` sur document
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lines: string[];
  speaker: string;
  portrait: ImageMetadata;
  skipLabel: string;
  /** Message affiché quand le son attend un premier clic / une touche. */
  startLabel: string;
  /** identifiant du dialogue : déjà vu pendant la visite = affiché d'un coup */
  id?: string;
}
const { lines, speaker, portrait, skipLabel, startLabel, id = 'home' } = Astro.props;
---

<div class="dialog" data-dialog data-lines={JSON.stringify(lines)} data-start={startLabel} data-id={id}>
  <div class="dialog__portrait">
    <Image src={portrait} alt={speaker} width={220} height={220} densities={[1, 2]} loading="eager" />
  </div>
  <div class="dialog__content">
    <p class="dialog__speaker pixel">{speaker}</p>
    <p class="dialog__text pixel" aria-live="polite" data-text>{lines.join(' ')}</p>
    <div class="dialog__footer">
      <button type="button" class="dialog__skip pixel" data-skip>{skipLabel}</button>
      <span class="dialog__next" aria-hidden="true" data-next>▼</span>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { typewrite, type Typing } from '../scripts/typewriter';
  import { soundBlocked, unlockSound } from '../scripts/sound';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-dialog]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const lines: string[] = JSON.parse(root.dataset.lines ?? '[]');
    const text = root.querySelector<HTMLElement>('[data-text]')!;
    const next = root.querySelector<HTMLElement>('[data-next]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let typing: Typing | null = null;
    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      root.dataset.done = '';
      document.dispatchEvent(new CustomEvent('dialog:done'));
    };
    const typeLine = () => {
      next.style.visibility = 'hidden';
      typing = typewrite(text, lines[index], {
        onDone: () => {
          next.style.visibility = 'visible';
          if (index >= lines.length - 1) finish();
        },
      });
    };
    const advance = () => {
      if (typing && !typing.done) return typing.finish();
      if (index < lines.length - 1) {
        index++;
        typeLine();
      }
    };
    const skipAll = () => {
      typing?.cancel();
      index = lines.length - 1;
      text.textContent = lines.join(' ');
      next.style.visibility = 'visible';
      finish();
    };

    root.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-skip]')) return skipAll();
      advance();
    });
    const onKey = (e: KeyboardEvent) => {
      if (finished || !document.body.contains(root)) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'z' || e.key === 'Z') {
        if ((e.target as HTMLElement).closest('a, button:not([data-skip])')) return;
        e.preventDefault();
        advance();
      } else if (e.key === 'Escape' || e.key === 'x' || e.key === 'X') {
        skipAll();
      }
    };
    document.addEventListener('keydown', onKey);
    document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', onKey), {
      once: true,
    });

    // Son activé mais bloqué par le navigateur (rechargement sans clic) :
    // on attend une première action pour débloquer le son, puis on lance le texte.
    const SEEN = `girelab:intro-seen:${root.dataset.id}`;
    const seen = (() => {
      try {
        return sessionStorage.getItem(SEEN) === '1';
      } catch {
        return false;
      }
    })();
    document.addEventListener(
      'dialog:done',
      () => {
        try {
          sessionStorage.setItem(SEEN, '1');
        } catch {
          /* stockage indisponible : le texte sera retapé, sans gravité */
        }
      },
      { once: true },
    );

    const start = () => {
      // déjà vu pendant cette visite : texte affiché d'un coup, menu tout de suite
      if (seen) return skipAll();
      if (!soundBlocked()) return typeLine();
      text.textContent = root.dataset.start ?? '';
      text.classList.add('dialog__text--wait');
      next.style.visibility = 'visible';
      const go = (e: Event) => {
        document.removeEventListener('pointerdown', go, true);
        document.removeEventListener('keydown', go, true);
        unlockSound();
        text.classList.remove('dialog__text--wait');
        // cette action sert uniquement à démarrer : on ne la laisse pas terminer le texte
        if (e.type === 'keydown') e.stopPropagation();
        else root.addEventListener('click', (c) => c.stopImmediatePropagation(), { once: true, capture: true });
        typeLine();
      };
      document.addEventListener('pointerdown', go, true);
      document.addEventListener('keydown', go, true);
    };

    // Ouverture du cadre « en escalier », puis le texte
    text.textContent = '';
    gsap.fromTo(
      root,
      { autoAlpha: 0, scaleY: 0.1 },
      { autoAlpha: 1, scaleY: 1, duration: reduce ? 0 : 0.35, ease: 'steps(5)', onComplete: start },
    );
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .dialog {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
    align-items: stretch;
    padding: clamp(16px, 2.5vw, 32px);
    background: var(--black);
    border: var(--border) solid var(--paper);
    box-shadow:
      0 0 0 var(--px) var(--night),
      0 0 0 calc(var(--px) * 2) var(--night-3);
    cursor: pointer;
    user-select: none;
    transform-origin: center;
  }
  :global(.js) .dialog {
    visibility: hidden;
  }
  .dialog__portrait {
    flex: none;
    width: clamp(120px, 16vw, 220px);
    aspect-ratio: 1;
    border: var(--border) solid var(--paper);
    overflow: hidden;
    background: var(--night-2);
  }
  .dialog__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dialog__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .dialog__speaker {
    margin: 0 0 calc(var(--px) * 2);
    color: var(--matcha);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }
  .dialog__text {
    flex: 1;
    margin: 0;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    line-height: 1.6;
    white-space: pre-wrap;
    min-height: 3.2em;
    max-width: 60ch;
  }
  .dialog__text--wait {
    color: var(--paper-dim);
    animation: blink-text 1.2s steps(2) infinite;
  }
  @keyframes blink-text {
    50% {
      opacity: 0.4;
    }
  }
  .dialog__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dialog__skip {
    background: none;
    border: none;
    color: var(--paper-dim);
    font-size: 0.85rem;
    cursor: pointer;
    padding: var(--px) 0;
  }
  .dialog__skip:hover {
    color: var(--kin);
  }
  .dialog[data-done] .dialog__skip {
    visibility: hidden;
  }
  .dialog__next {
    color: var(--kin);
    visibility: hidden;
    animation: bob 0.8s steps(2) infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(var(--px));
    }
  }
  @media (max-width: 600px) {
    .dialog {
      flex-direction: column;
    }
    .dialog__portrait {
      width: 104px;
    }
  }
</style>
