---
/**
 * Fond animé : lucioles et pétales en pixels sur un canvas 2D.
 * Rendu en basse résolution puis agrandi (pixelated) : léger et dans la DA.
 * Persiste entre les pages grâce à transition:persist.
 */
---

<canvas class="fireflies" aria-hidden="true" transition:persist="fireflies" data-fireflies></canvas>

<script>
  const SCALE = 4; // 1 pixel du canvas = 4 pixels écran

  type P = { x: number; y: number; vx: number; vy: number; phase: number; kind: 'fly' | 'petal' };

  function start(canvas: HTMLCanvasElement) {
    if (canvas.dataset.running) return;
    canvas.dataset.running = '1';
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0;
    let h = 0;
    let parts: P[] = [];

    const resize = () => {
      w = Math.ceil(innerWidth / SCALE);
      h = Math.ceil(innerHeight / SCALE);
      canvas.width = w;
      canvas.height = h;
      const count = Math.round((w * h) / 900);
      parts = Array.from({ length: count }, (_, i) => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.08,
        vy: i % 5 === 0 ? 0.06 + Math.random() * 0.05 : (Math.random() - 0.5) * 0.06,
        phase: Math.random() * Math.PI * 2,
        kind: i % 5 === 0 ? 'petal' : 'fly',
      }));
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const p of parts) {
        if (!reduce) {
          p.x += p.vx + (p.kind === 'petal' ? Math.sin(t / 900 + p.phase) * 0.05 : 0);
          p.y += p.vy;
          if (p.x < -2) p.x = w + 2;
          if (p.x > w + 2) p.x = -2;
          if (p.y > h + 2) p.y = -2;
          if (p.y < -2) p.y = h + 2;
        }
        const x = Math.round(p.x);
        const y = Math.round(p.y);
        if (p.kind === 'fly') {
          const glow = (Math.sin(t / 700 + p.phase) + 1) / 2;
          ctx.globalAlpha = 0.15 + glow * 0.75;
          ctx.fillStyle = '#f3c25b';
          ctx.fillRect(x, y, 1, 1);
          if (glow > 0.8) {
            ctx.globalAlpha = 0.25;
            ctx.fillRect(x - 1, y, 3, 1);
            ctx.fillRect(x, y - 1, 1, 3);
          }
        } else {
          ctx.globalAlpha = 0.55;
          ctx.fillStyle = '#e8553d';
          ctx.fillRect(x, y, 2, 1);
        }
      }
      ctx.globalAlpha = 1;
      if (!reduce) requestAnimationFrame(draw);
    };

    resize();
    addEventListener('resize', resize);
    requestAnimationFrame(draw);
  }

  document.addEventListener('astro:page-load', () => {
    const c = document.querySelector<HTMLCanvasElement>('[data-fireflies]');
    if (c) start(c);
  });
</script>

<style>
  .fireflies {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    image-rendering: pixelated;
    pointer-events: none;
  }
</style>
