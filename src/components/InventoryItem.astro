---
/** Case d'inventaire : une entrée de projet (jeu, outil, script). */
interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
  tags?: string[];
  status?: string;
}
const { href, title, description, icon, tags = [], status } = Astro.props;
---

<a class="item" href={href} data-reveal>
  <span class="item__icon pixel" aria-hidden="true">{icon}</span>
  <span class="item__main">
    <span class="item__title pixel">{title}</span>
    <span class="item__desc">{description}</span>
    {
      tags.length > 0 && (
        <span class="item__tags">
          {tags.map((t) => (
            <span class="item__tag">{t}</span>
          ))}
        </span>
      )
    }
  </span>
  {status && <span class="item__status pixel">{status}</span>}
</a>

<style>
  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: calc(var(--px) * 4);
    align-items: start;
    padding: calc(var(--px) * 4);
    color: var(--paper);
    border: var(--border) solid var(--night-3);
    background: var(--night);
    transition:
      border-color var(--dur-fast) steps(2),
      transform var(--dur) var(--ease-out);
  }
  .item:hover,
  .item:focus-visible {
    color: var(--paper);
    border-color: var(--kin);
    transform: translateX(var(--px));
  }
  .item__icon {
    display: grid;
    place-items: center;
    width: calc(var(--px) * 12);
    aspect-ratio: 1;
    border: var(--border) solid var(--paper);
    font-size: 1.4rem;
    color: var(--matcha);
  }
  .item__main {
    display: grid;
    gap: var(--px);
  }
  .item__title {
    font-size: 1.15rem;
  }
  .item:hover .item__title {
    color: var(--kin);
  }
  .item__desc {
    color: var(--paper-dim);
    font-size: 0.95rem;
  }
  .item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--px) * 2);
    margin-top: var(--px);
  }
  .item__tag {
    font-size: 0.75rem;
    padding: 0 calc(var(--px) * 2);
    border: 1px solid var(--ai);
    color: var(--paper-dim);
  }
  @media (max-width: 480px) {
    .item {
      grid-template-columns: auto 1fr;
    }
    .item__status {
      grid-column: 2;
      justify-self: start;
    }
  }
  .item__status {
    font-size: 0.75rem;
    color: var(--matcha);
    white-space: nowrap;
  }
</style>
