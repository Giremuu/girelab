---
/**
 * Page Jeux (/jeux/ et /en/games/) : liste des fiches `kind: game`,
 * ou écran « Bientôt disponible » tant qu'il n'y en a aucune.
 */
import Base from '../../../layouts/Base.astro';
import Window from '../../../components/Window.astro';
import ProjectList from '../../../components/ProjectList.astro';
import ComingSoon from '../../../components/ComingSoon.astro';
import { localeParams, langFromParam } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getProjects } from '../../../lib/projects';
import { segmentFor } from '../../../i18n/routes';

export function getStaticPaths() {
  // une page par langue, nom de section traduit : /jeux/ et /en/games/ (voir src/i18n/routes.ts)
  return localeParams.map((locale) => ({
    params: { locale, jeux: segmentFor('jeux', langFromParam(locale)) },
  }));
}

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const games = await getProjects(['game'], lang);
---

<Base lang={lang} title={t('games.title')} description={t('games.description')}>
  <h1 class="page-title">{t('games.title')}</h1>
  {
    games.length === 0 ? (
      <ComingSoon title={t('soon.title')} text={t('games.soon')} />
    ) : (
      <Window title={t('inventory')}>
        <ProjectList projects={games} lang={lang} min="380px" />
      </Window>
    )
  }
</Base>
